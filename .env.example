# GIGATON Research Reader - environment template
#
# Generate a real token on the server with:
#   openssl rand -hex 32
# Then put it in a private .env file (chmod 600 .env). Never commit real tokens.
#
# Optional: override which interface the API binds to.
# Defaults to the Tailscale IPv4 100.82.221.72. Use 127.0.0.1 for local-only
# testing when Tailscale's interface is not yet present.
READER_API_TOKEN=replace-with-a-long-random-secret
# SERVER_BIND_IP=100.82.221.72